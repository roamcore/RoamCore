# RoamCore bake-in — generic Atheros/MT76 (ath79-generic)
#
# This is a "catch-all" target for older / cheaper routers that fall
# back to the Atheros ath79 or MediaTek mt76 subtrees. It will not
# produce a single .itb — it produces a per-subtarget image; we expect
# maintainers to extend this manifest when a specific subtarget is
# chosen (e.g. ath79-tiny, mt76x2-generic).
#
# For the purposes of the "any router" acceptance criterion, this
# manifest is intentionally conservative: includes the networking +
# firewall + LuCI + Python3 stack but does NOT pin a Wi-Fi driver,
# since that varies by subtarget.

# --- Core / networking ---------------------------------------------------
-uci-defaults
-ppp
-pppoe
-pppoe-discovery
-iptables
-iptables-mod-conntrack-extra
-iptables-mod-nat-extra
-kmod-nf-nat
-kmod-nf-conntrack
-kmod-mppe

# --- Wi-Fi (driver picked by subtarget at runtime) -----------------------
-wpad-wolfssl

# --- LuCI ----------------------------------------------------------------
-luci
-luci-base
-luci-mod-admin-full
-luci-theme-bootstrap
-luci-app-firewall
-luci-app-network
-luci-app-system

# --- Runtime -------------------------------------------------------------
-python3
-python3-light
-python3-logging
-busybox
-coreutils
-base64
-nano

# --- RoamCore overlays (NOT opkg packages) -------------------------------
# See x86_64-generic.manifest for the FILES-list summary.