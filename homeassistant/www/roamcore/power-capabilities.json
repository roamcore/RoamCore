{
  "$schema": "./power-capabilities.schema.json",
  "version": 1,
  "description": "Capability manifest for the RoamCore Power detail page. Each tile lists the rc_* contract entities it needs. If any required entity is missing/unavailable/unknown, the tile is hidden (not greyed). Optional entities enable sub-sections when present.",
  "tiles": [
    {
      "id": "battery",
      "title": "Battery",
      "icon": "",
      "span": 2,
      "required": [
        "sensor.rc_power_battery_soc"
      ],
      "optional": [
        "sensor.rc_power_battery_voltage",
        "sensor.rc_power_battery_current",
        "sensor.rc_power_battery_temperature",
        "sensor.rc_power_battery_temperature_2",
        "sensor.rc_power_battery_capacity",
        "sensor.rc_power_battery_cycle_count",
        "sensor.rc_power_battery_health",
        "sensor.rc_power_battery_time_to_full"
      ]
    },
    {
      "id": "solar",
      "title": "Solar",
      "icon": "\u2600",
      "span": 1,
      "required": [
        "sensor.rc_power_solar_power"
      ],
      "optional": [
        "sensor.rc_power_solar_energy_today",
        "sensor.rc_power_solar_energy_total",
        "sensor.rc_power_solar_panel_voltage",
        "sensor.rc_power_solar_panel_current",
        "sensor.rc_power_solar_efficiency",
        "sensor.rc_power_solar_pv2_power"
      ]
    },
    {
      "id": "inverter",
      "title": "Inverter",
      "icon": "\u2393",
      "span": 1,
      "required": [
        "sensor.rc_power_inverter_status"
      ],
      "optional": [
        "sensor.rc_power_inverter_output_power",
        "sensor.rc_power_inverter_output_voltage",
        "sensor.rc_power_inverter_frequency",
        "sensor.rc_power_inverter_temperature",
        "sensor.rc_power_ac_out_power"
      ]
    },
    {
      "id": "shore",
      "title": "Shore Power",
      "icon": "\u238d",
      "span": 1,
      "required": [
        "binary_sensor.rc_power_shore_connected"
      ],
      "optional": [
        "sensor.rc_power_shore_voltage",
        "sensor.rc_power_shore_current",
        "sensor.rc_power_shore_power",
        "sensor.rc_power_ac_in_power"
      ]
    },
    {
      "id": "alternator",
      "title": "Alternator",
      "icon": "\u2388",
      "span": 1,
      "required": [
        "sensor.rc_power_alternator_voltage"
      ],
      "optional": [
        "sensor.rc_power_alternator_current",
        "sensor.rc_power_alternator_power"
      ]
    },
    {
      "id": "cell-bms",
      "title": "Cell / BMS",
      "icon": "\u25c8",
      "span": 1,
      "required": [
        "sensor.rc_power_battery_cells_voltage"
      ],
      "optional": [
        "sensor.rc_power_battery_temperature",
        "sensor.rc_power_battery_temperature_2",
        "sensor.rc_power_battery_health"
      ]
    },
    {
      "id": "dc-loads",
      "title": "DC Loads",
      "icon": "\u26a1",
      "span": 1,
      "required": [
        "sensor.rc_power_load_power"
      ],
      "optional": [
        "sensor.rc_power_load_fridge",
        "sensor.rc_power_load_lights",
        "sensor.rc_power_load_heater",
        "sensor.rc_power_load_water_pump",
        "sensor.rc_power_load_other",
        "sensor.rc_power_dc_load_current"
      ]
    },
    {
      "id": "history",
      "title": "History",
      "icon": "\u223f",
      "span": 2,
      "required": [
        "sensor.rc_power_battery_soc"
      ],
      "optional": [
        "sensor.rc_power_solar_power",
        "sensor.rc_power_load_power"
      ]
    }
  ]
}